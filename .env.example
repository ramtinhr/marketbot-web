# Development: where `npm run dev` (and docker-compose.yml) proxies /api and
# /health to (marketbot-api).
API_PROXY_TARGET=http://127.0.0.1:8080

# Build time: the API base the browser calls. Leave unset for same-origin
# /api/v1 (dev proxy, or the nginx in deploy/). Set it only when the API is on
# another origin, e.g. https://api.example.com/api/v1 - marketbot-api allows
# CORS for that, but see README about basic auth.
# VITE_API_BASE=

# Where the image's nginx listens (docker-compose.yml and docker-compose.prod.yml).
# In production it must match WEB_PORT in marketbot-api's .env, whose nginx
# serves the dashboard on WEB_DOMAIN.
WEB_PORT=8081

# Production only (docker-compose.prod.yml): marketbot-api's PORT on this host.
API_PORT=8080
